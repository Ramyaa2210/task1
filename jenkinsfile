pipeline{
    agent any
    stages{
        stage('Checkout'){
            steps{
                git branch:'main',url:

            }
        }
        stage('Install Dependancies'){
            steps{
                bat 'pip install -r requirements.txt'
            }
        }
        stage('Run Unit Tests'){
            steps{
                bat 'pytest test_app.py'
            }
        }
    }
}